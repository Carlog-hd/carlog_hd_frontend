<?xml version="1.0" encoding="utf-8"?>
<!-- CARLOG IVI 홈 화면 (carlog-demo.html .cockpit + ivHome() 기준) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cl_bg"
    android:orientation="horizontal">

    <!-- ===== 왼쪽 레일 ===== -->
    <LinearLayout
        android:id="@+id/rail"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="@color/cl_rail"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="44dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="60dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.08"
                android:text="@string/logo_car"
                android:textColor="@color/cl_fg"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.08"
                android:text="@string/logo_log"
                android:textColor="@color/cl_lime"
                android:textSize="38sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHome"
            style="@style/Carlog.NavItem">

            <ImageView
                style="@style/Carlog.NavItem.Icon"
                android:src="@drawable/ic_nav_home" />

            <TextView
                style="@style/Carlog.NavItem.Label"
                android:text="@string/nav_home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navDrive"
            style="@style/Carlog.NavItem">

            <ImageView
                style="@style/Carlog.NavItem.Icon"
                android:src="@drawable/ic_nav_drive" />

            <TextView
                style="@style/Carlog.NavItem.Label"
                android:text="@string/nav_drive" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navCourse"
            style="@style/Carlog.NavItem">

            <ImageView
                style="@style/Carlog.NavItem.Icon"
                android:src="@drawable/ic_nav_course" />

            <TextView
                style="@style/Carlog.NavItem.Label"
                android:text="@string/nav_course" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTitles"
            style="@style/Carlog.NavItem">

            <ImageView
                style="@style/Carlog.NavItem.Icon"
                android:src="@drawable/ic_nav_titles" />

            <TextView
                style="@style/Carlog.NavItem.Label"
                android:text="@string/nav_titles" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/rail_foot"
            android:textColor="@color/cl_railfoot"
            android:textSize="22sp" />
    </LinearLayout>

    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:background="@color/cl_edge" />

    <!-- ===== 작업 영역 ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 상단 상태 바 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="124dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="52dp">

            <View
                android:id="@+id/liveDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_live_dot" />

            <TextView
                android:id="@+id/liveText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="@string/status_idle"
                android:textColor="@color/cl_aqua"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusClock"
                style="@style/Carlog.Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_clock_sample" />

            <TextView
                android:id="@+id/statusSpeed"
                style="@style/Carlog.Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:text="@string/status_speed_sample" />

            <TextView
                android:id="@+id/statusGear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:background="@drawable/bg_gear"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:text="@string/status_gear_sample"
                android:textColor="@color/cl_lime"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusWeather"
                style="@style/Carlog.Text.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:text="@string/status_weather_sample" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cl_edge" />

        <!-- 탭 화면 컨테이너 -->
        <FrameLayout
            android:id="@+id/screenContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
