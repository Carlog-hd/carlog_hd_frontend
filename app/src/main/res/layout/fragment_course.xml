<?xml version="1.0" encoding="utf-8"?>
<!-- 코스 탭 (carlog-demo.html ivDiscover() 기준, 친구 코스를 받은 상태 샘플) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="52dp"
        android:paddingEnd="60dp"
        android:paddingBottom="56dp">

        <TextView
            style="@style/Carlog.Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/course_kicker" />

        <TextView
            android:id="@+id/courseHeadline"
            style="@style/Carlog.Text.Headline"
            android:text="@string/course_headline_sample" />

        <TextView
            android:id="@+id/courseLead"
            style="@style/Carlog.Text.Lead"
            android:text="@string/course_lead_sample" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 친구 코스 지도 -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="760dp"
                android:layout_weight="1.4">

                <com.example.carlog_hd_frontend.ui.map.RouteMapView
                    android:id="@+id/courseMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/course_map_desc"
                    app:carlogHideStart="true"
                    app:carlogProgress="1"
                    app:carlogRoute="minji" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="36dp"
                    android:background="@drawable/bg_navcard"
                    android:paddingHorizontal="28dp"
                    android:paddingVertical="16dp"
                    android:text="@string/course_start_hidden"
                    android:textColor="@color/cl_muted"
                    android:textSize="24sp" />
            </FrameLayout>

            <!-- 오른쪽 열 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 총거리 · 실제 소요 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="24dp">

                        <TextView
                            style="@style/Carlog.Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/course_total_distance" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/courseDistance"
                                style="@style/Carlog.Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_total_distance_sample" />

                            <TextView
                                style="@style/Carlog.Text.Unit"
                                android:text="@string/unit_km" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:paddingHorizontal="32dp"
                        android:paddingVertical="24dp">

                        <TextView
                            style="@style/Carlog.Text.StatLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/course_actual_time" />

                        <TextView
                            android:id="@+id/courseTime"
                            style="@style/Carlog.Text.StatValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/course_actual_time_sample"
                            android:textSize="42sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 경유지 목록 -->
                <LinearLayout
                    android:id="@+id/waypointPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <TextView
                        style="@style/Carlog.Text.Tiny"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/course_waypoints_label"
                        android:textSize="24sp" />

                    <LinearLayout style="@style/Carlog.Waypoint">

                        <TextView
                            style="@style/Carlog.Waypoint.Badge"
                            android:text="1" />

                        <TextView
                            style="@style/Carlog.Waypoint.Name"
                            android:text="@string/course_wp1_sample" />
                    </LinearLayout>

                    <LinearLayout style="@style/Carlog.Waypoint">

                        <TextView
                            style="@style/Carlog.Waypoint.Badge"
                            android:text="2" />

                        <TextView
                            style="@style/Carlog.Waypoint.Name"
                            android:text="@string/course_wp2_sample" />
                    </LinearLayout>

                    <LinearLayout style="@style/Carlog.Waypoint">

                        <TextView
                            style="@style/Carlog.Waypoint.Badge"
                            android:text="3" />

                        <TextView
                            style="@style/Carlog.Waypoint.Name"
                            android:text="@string/course_wp3_sample" />
                    </LinearLayout>

                    <LinearLayout style="@style/Carlog.Waypoint">

                        <TextView
                            style="@style/Carlog.Waypoint.Badge"
                            android:background="@drawable/bg_wp_end"
                            android:text="@string/course_arrival"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/Carlog.Waypoint.Name"
                            android:text="@string/course_dest_sample" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_note"
                    android:lineSpacingMultiplier="1.4"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="20dp"
                    android:text="@string/course_note"
                    android:textColor="@color/cl_muted"
                    android:textSize="24sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFollowCourse"
                    style="@style/Carlog.Button"
                    android:layout_width="match_parent"
                    android:layout_height="128dp"
                    android:layout_marginTop="28dp"
                    android:text="@string/course_follow"
                    android:textSize="38sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
