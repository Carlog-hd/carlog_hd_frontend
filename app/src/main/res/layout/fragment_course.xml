<?xml version="1.0" encoding="utf-8"?>
<!-- 차량용 발견: 풍경 카드 목록에서 코스를 고른 뒤 상세 안내를 보여줍니다. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/courseScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:scrollbarFadeDuration="0"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="32dp"
        android:paddingEnd="48dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:id="@+id/courseList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Carlog.Text.Kicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/course_kicker" />

            <TextView
                style="@style/Carlog.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_discover_headline" />

            <TextView
                style="@style/Carlog.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_discover_lead" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/courseFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/courseChoices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/courseDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCourseBack"
                style="@style/Carlog.Button.GhostSmall"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:text="@string/course_back_to_list"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/courseHeadline"
                style="@style/Carlog.Text.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_headline_sample"
                android:textSize="48sp" />

            <TextView
                android:id="@+id/courseLead"
                style="@style/Carlog.Text.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/course_lead_sample"
                android:textSize="24sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:orientation="vertical">

                    <com.example.carlog_hd_frontend.ui.map.RouteMapView
                        android:id="@+id/courseMap"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:contentDescription="@string/course_map_desc"
                        app:carlogHideStart="true"
                        app:carlogProgress="1"
                        app:carlogRoute="minji" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="12dp">
                            <TextView
                                style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_total_distance" />
                            <TextView
                                android:id="@+id/courseDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cl_fg"
                                android:textSize="32sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="12dp">
                            <TextView
                                style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/course_actual_time" />
                            <TextView
                                android:id="@+id/courseTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/cl_fg"
                                android:textSize="28sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLikeCourse"
                            style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_weight="1"
                            android:text="@string/course_like"
                            android:textSize="20sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSaveCourse"
                            style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/course_save"
                            android:textSize="20sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnFollowCourse"
                            style="@style/Carlog.Button"
                            android:layout_width="0dp"
                            android:layout_height="72dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1.5"
                            android:text="@string/course_follow"
                            android:textSize="22sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/waypointPanel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="16dp">

                    <TextView
                        style="@style/Carlog.Text.Tiny"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/course_waypoints_label"
                        android:textSize="20sp" />
                    <LinearLayout
                        android:id="@+id/courseWaypoints"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/courseDemoNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_note"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="@string/course_note_dynamic"
                android:textColor="@color/cl_muted"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
