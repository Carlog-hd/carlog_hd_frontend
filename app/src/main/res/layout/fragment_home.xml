<?xml version="1.0" encoding="utf-8"?>
<!-- 홈 탭 (carlog-demo.html ivHome() 기준) -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="52dp"
        android:paddingEnd="60dp"
        android:paddingBottom="56dp">

        <TextView
            style="@style/Carlog.Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_kicker" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="-0.05"
            android:text="@string/home_headline"
            android:textColor="@color/cl_fg"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/home_lead"
            android:textColor="@color/cl_muted"
            android:textSize="28sp" />

        <!-- 2단 그리드 (1.4fr : 1fr) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 목적지 패널 -->
            <LinearLayout
                android:id="@+id/destinationPanel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.4"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="40dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Carlog.Text.PanelTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_destination" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingHorizontal="22dp"
                        android:paddingVertical="12dp"
                        android:text="@string/home_nav_pill"
                        android:textColor="@color/cl_pill_fg"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.example.carlog_hd_frontend.ui.map.RouteMapView
                    android:id="@+id/routeMap"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:layout_marginTop="28dp"
                    android:contentDescription="@string/home_route_map_desc"
                    app:carlogRoute="mine"
                    app:carlogProgress="0"
                    app:carlogShowTrack="true"
                    app:carlogShowStop="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/destName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_dest_name_sample"
                            android:textColor="@color/cl_fg"
                            android:textSize="40sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/destMeta"
                            style="@style/Carlog.Text.Tiny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_dest_meta_sample" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartGuidance"
                        style="@style/Carlog.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_start_guidance" />
                </LinearLayout>
            </LinearLayout>

            <!-- 오른쪽 열 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- 나의 드라이버 -->
                <LinearLayout
                    android:id="@+id/myDriverPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical"
                    android:padding="40dp">

                    <TextView
                        style="@style/Carlog.Text.PanelTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="28dp"
                        android:text="@string/home_my_driver" />

                    <TextView
                        android:id="@+id/myDriverTitle"
                        style="@style/Carlog.Text.Tiny"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_no_title" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:orientation="vertical"
                            android:paddingHorizontal="32dp"
                            android:paddingVertical="24dp">

                            <TextView
                                style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_saved_drives" />

                            <TextView
                                android:id="@+id/statSavedDrives"
                                style="@style/Carlog.Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_saved_drives_sample" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_stat"
                            android:orientation="vertical"
                            android:paddingHorizontal="32dp"
                            android:paddingVertical="24dp">

                            <TextView
                                style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_title_collection" />

                            <TextView
                                android:id="@+id/statTitleCollection"
                                style="@style/Carlog.Text.StatValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/home_title_collection_sample" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- 휴대전화에서 받은 코스 -->
                <LinearLayout
                    android:id="@+id/receivedCoursePanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="40dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="24dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_received_course"
                            android:textColor="@color/cl_fg"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/receivedCourseText"
                            style="@style/Carlog.Text.Tiny"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_received_course_empty" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenCourse"
                        style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.4"
                        android:enabled="false"
                        android:text="@string/home_open" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
