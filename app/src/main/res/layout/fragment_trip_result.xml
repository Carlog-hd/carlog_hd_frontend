<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="52dp"
        android:paddingEnd="60dp"
        android:paddingBottom="56dp">

        <TextView
            style="@style/Carlog.Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARLOG SIMULATION" />

        <TextView
            style="@style/Carlog.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_title" />

        <TextView
            android:id="@+id/resultDestination"
            style="@style/Carlog.Text.Lead"
            android:text="@string/home_dest_name_sample" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_saved"
                android:textColor="@color/cl_aqua"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_distance_label" />

                    <TextView
                        android:id="@+id/resultDistance"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_duration_label" />

                    <TextView
                        android:id="@+id/resultDuration"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0분 00초" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_average_label" />

                    <TextView
                        android:id="@+id/resultAverage"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km/h" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/resultEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_note"
                android:lineSpacingMultiplier="1.3"
                android:padding="24dp"
                android:text="@string/result_home_events"
                android:textColor="@color/cl_muted"
                android:textSize="24sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResultHome"
                style="@style/Carlog.Button"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="28dp"
                android:text="@string/result_home_button" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
