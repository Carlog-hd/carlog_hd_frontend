<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="60dp"
        android:paddingTop="52dp"
        android:paddingEnd="60dp"
        android:paddingBottom="56dp">

        <TextView
            style="@style/Carlog.Text.Kicker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARLOG SIMULATION" />

        <TextView
            android:id="@+id/resultHeadline"
            style="@style/Carlog.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/result_title" />

        <TextView
            android:id="@+id/resultDestination"
            style="@style/Carlog.Text.Lead"
            android:text="@string/home_dest_name_sample" />

        <TextView
            android:id="@+id/resultRecordedAt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/cl_muted"
            android:textSize="20sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_log_map_title"
                android:textColor="@color/cl_fg"
                android:textSize="26sp"
                android:textStyle="bold" />

            <com.example.carlog_hd_frontend.ui.map.RouteMapView
                android:id="@+id/resultRouteMap"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/my_log_map_description" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="40dp">

            <TextView
                android:id="@+id/resultSavedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/result_saved"
                android:textColor="@color/cl_aqua"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_distance_label" />

                    <TextView
                        android:id="@+id/resultDistance"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0 km" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_duration_label" />

                    <TextView
                        android:id="@+id/resultDuration"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0분 00초" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_stat"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        style="@style/Carlog.Text.StatLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_average_label" />

                    <TextView
                        android:id="@+id/resultAverage"
                        style="@style/Carlog.Text.StatValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km/h" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/resultEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_note"
                android:lineSpacingMultiplier="1.3"
                android:padding="24dp"
                android:text="@string/result_home_events"
                android:textColor="@color/cl_muted"
                android:textSize="24sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_log_media_title"
                android:textColor="@color/cl_fg"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultMediaEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/my_log_media_empty"
                android:textColor="@color/cl_muted"
                android:textSize="20sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/resultMediaList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddLogMedia"
                    style="@style/Carlog.Button.GhostSmall"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/my_log_add_media" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditLog"
                    style="@style/Carlog.Button.GhostSmall"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/my_log_edit" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_log_auto_title"
                android:textColor="@color/cl_aqua"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/resultLogCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_note"
                android:lineSpacingMultiplier="1.25"
                android:padding="20dp"
                android:textColor="@color/cl_fg"
                android:textSize="22sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPreviewShorts"
                style="@style/Carlog.Button"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginTop="16dp"
                android:text="@string/my_log_preview_shorts" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResultHome"
            style="@style/Carlog.Button"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="24dp"
            android:text="@string/result_home_button" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
