<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- IVI 화면은 항상 다크 테마로 표시 -->
    <style name="Theme.Carlog_hd_frontend" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/cl_lime</item>
        <item name="colorPrimaryVariant">@color/cl_rail</item>
        <item name="colorOnPrimary">@color/cl_on_lime</item>
        <item name="colorSecondary">@color/cl_aqua</item>
        <item name="colorSecondaryVariant">@color/cl_aqua</item>
        <item name="colorOnSecondary">@color/cl_rail</item>
        <item name="android:colorBackground">@color/cl_bg</item>
        <item name="android:windowBackground">@color/cl_bg</item>
        <item name="android:statusBarColor">@color/cl_rail</item>
        <item name="android:navigationBarColor">@color/cl_rail</item>
    </style>

    <style name="ShapeAppearance.Carlog.Map" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">40dp</item>
    </style>

    <!-- 텍스트 스타일 -->
    <style name="Carlog.Text.Kicker" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textColor">@color/cl_aqua</item>
    </style>

    <style name="Carlog.Text.PanelTitle" parent="">
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cl_fg</item>
    </style>

    <style name="Carlog.Text.Tiny" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/cl_muted</item>
    </style>

    <style name="Carlog.Text.StatLabel" parent="Carlog.Text.Tiny" />

    <style name="Carlog.Text.StatValue" parent="">
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/cl_fg</item>
    </style>

    <style name="Carlog.Text.Status" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/cl_muted</item>
    </style>

    <!-- 레일 내비 항목 -->
    <style name="Carlog.NavItem" parent="">
        <item name="android:layout_width">156dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">148dp</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Carlog.NavItem.Icon" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="tint">@color/nav_item_content</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Carlog.NavItem.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textColor">@color/nav_item_content</item>
    </style>

    <!-- 버튼 -->
    <style name="Carlog.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/cl_lime</item>
        <item name="android:textColor">@color/cl_on_lime</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:paddingStart">36dp</item>
        <item name="android:paddingEnd">36dp</item>
    </style>

    <style name="Carlog.Button.GhostSmall">
        <item name="backgroundTint">@color/cl_ghost</item>
        <item name="android:textColor">@color/cl_on_ghost</item>
        <item name="android:textSize">24sp</item>
        <item name="cornerRadius">22dp</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <!-- 화면 공통 제목 -->
    <style name="Carlog.Text.Headline" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:letterSpacing">-0.05</item>
        <item name="android:textColor">@color/cl_fg</item>
        <item name="android:textSize">60sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Carlog.Text.Lead" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/cl_muted</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- 통계 값 옆 단위 (km, km/h) -->
    <style name="Carlog.Text.Unit" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:textColor">@color/cl_muted</item>
        <item name="android:textSize">28sp</item>
    </style>

    <!-- 코스 경유지 행 -->
    <style name="Carlog.Waypoint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <style name="Carlog.Waypoint.Badge" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_wp_num</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/cl_rail</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Carlog.Waypoint.Name" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:textColor">@color/cl_fg</item>
        <item name="android:textSize">32sp</item>
    </style>
</resources>
