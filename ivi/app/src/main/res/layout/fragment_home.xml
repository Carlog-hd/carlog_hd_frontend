<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingTop="42dp"
        android:paddingEnd="52dp"
        android:paddingBottom="52dp">
        <TextView style="@style/Carlog.Text.Kicker"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/home_kicker" />
        <TextView style="@style/Carlog.Text.Headline"
            android:text="@string/home_headline" />
        <TextView style="@style/Carlog.Text.Lead"
            android:text="@string/home_lead" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="34dp" android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.35" android:background="@drawable/bg_panel"
                android:orientation="vertical" android:padding="32dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView style="@style/Carlog.Text.PanelTitle"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/home_recent_drive" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill" android:paddingHorizontal="18dp"
                        android:paddingVertical="10dp" android:text="@string/home_auto_created"
                        android:textColor="@color/cl_pill_fg" android:textSize="20sp" />
                </LinearLayout>
                <FrameLayout android:layout_width="match_parent" android:layout_height="360dp"
                    android:layout_marginTop="24dp" android:background="@drawable/bg_recent_cover">
                    <TextView android:id="@+id/recentBadge"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start" android:layout_marginStart="26dp"
                        android:layout_marginBottom="155dp" android:background="@drawable/bg_pill"
                        android:paddingHorizontal="16dp" android:paddingVertical="8dp"
                        android:text="@string/home_recent_badge" android:textColor="@color/cl_pill_fg"
                        android:textSize="18sp" />
                    <TextView android:id="@+id/recentTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:layout_marginHorizontal="26dp"
                        android:layout_marginBottom="68dp" android:maxLines="2"
                        android:text="@string/home_recent_empty_title" android:textColor="@color/cl_fg"
                        android:textSize="40sp" android:textStyle="bold" />
                    <TextView android:id="@+id/recentMeta"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:layout_marginHorizontal="26dp"
                        android:layout_marginBottom="24dp" android:maxLines="1"
                        android:text="@string/home_recent_empty_meta" android:textColor="@color/cl_fg"
                        android:textSize="22sp" />
                </FrameLayout>
                <TextView android:id="@+id/recentTitlePill"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="18dp" android:paddingVertical="10dp"
                    android:text="@string/home_first_drive_hint" android:textColor="@color/cl_gold_pill_fg"
                    android:textSize="20sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRecentDrive" style="@style/Carlog.Button"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="@string/home_recent_open" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartGuidance" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="18dp" android:text="@string/home_start_guidance" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="24dp" android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel" android:orientation="vertical"
                    android:padding="32dp">
                    <TextView style="@style/Carlog.Text.PanelTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/home_my_driver" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="22dp" android:text="🚙" android:textSize="46sp" />
                    <TextView android:id="@+id/myDriverTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:text="@string/home_no_title" android:textColor="@color/cl_fg"
                        android:textSize="28sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="26dp" android:baselineAligned="false"
                        android:orientation="horizontal">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_stat"
                            android:orientation="vertical" android:padding="22dp">
                            <TextView style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/home_saved_drives" />
                            <TextView android:id="@+id/statSavedDrives" style="@style/Carlog.Text.StatValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/home_saved_drives_sample" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="16dp" android:layout_weight="1"
                            android:background="@drawable/bg_stat" android:orientation="vertical"
                            android:padding="22dp">
                            <TextView style="@style/Carlog.Text.StatLabel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="@string/home_title_collection" />
                            <TextView android:id="@+id/statTitleCollection"
                                style="@style/Carlog.Text.StatValue" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="@string/home_title_collection_sample" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="24dp" android:background="@drawable/bg_panel"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:padding="32dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/home_popular_course" android:textColor="@color/cl_fg"
                            android:textSize="28sp" android:textStyle="bold" />
                        <TextView android:id="@+id/receivedCourseText" style="@style/Carlog.Text.Tiny"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/home_popular_course_sample" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenCourse" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="14dp" android:text="@string/home_discover" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
