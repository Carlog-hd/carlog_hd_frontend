<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="52dp" android:paddingTop="40dp"
        android:paddingEnd="52dp" android:paddingBottom="48dp">

        <TextView style="@style/Carlog.Text.Kicker" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/my_kicker" />
        <TextView style="@style/Carlog.Text.Headline" android:text="@string/my_headline" />
        <TextView style="@style/Carlog.Text.Lead" android:text="@string/my_lead" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.05" android:background="@drawable/bg_panel"
                android:orientation="vertical" android:padding="28dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:layout_width="68dp" android:layout_height="68dp"
                        android:background="@drawable/bg_stat" android:gravity="center"
                        android:text="🚙" android:textSize="36sp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="18dp" android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:text="@string/my_profile_name" android:textColor="@color/cl_fg"
                            android:textSize="30sp" android:textStyle="bold" />
                        <TextView android:id="@+id/myProfileTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="5dp"
                            android:textColor="@color/cl_pill_fg" android:textSize="21sp" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="24dp" android:background="@color/cl_edge" />
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="22dp"
                    android:text="@string/my_month_summary" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_stat"
                        android:orientation="vertical" android:padding="18dp">
                        <TextView style="@style/Carlog.Text.StatLabel" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/my_month_drives" />
                        <TextView android:id="@+id/myDriveCount" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:textColor="@color/cl_fg" android:textSize="34sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:background="@drawable/bg_stat" android:orientation="vertical"
                        android:padding="18dp">
                        <TextView style="@style/Carlog.Text.StatLabel" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/my_month_distance" />
                        <TextView android:id="@+id/myTotalDistance" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:textColor="@color/cl_fg" android:textSize="34sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:background="@drawable/bg_stat"
                        android:orientation="vertical" android:padding="18dp">
                        <TextView style="@style/Carlog.Text.StatLabel" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/my_month_average_speed" />
                        <TextView android:id="@+id/myAverageSpeed" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:textColor="@color/cl_fg" android:textSize="34sp" android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_marginStart="12dp" android:layout_weight="1"
                        android:background="@drawable/bg_stat" android:orientation="vertical"
                        android:padding="18dp">
                        <TextView style="@style/Carlog.Text.StatLabel" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:text="@string/my_month_received_likes" />
                        <TextView android:id="@+id/myReceivedLikes" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="6dp"
                            android:textColor="@color/cl_fg" android:textSize="34sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp"
                    android:layout_marginTop="24dp" android:background="@color/cl_edge" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="22dp" android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/my_recent_drives" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMyAllRecords" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="60dp"
                        android:text="@string/my_all_drives" />
                </LinearLayout>
                <LinearLayout android:id="@+id/myRecentDrives" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel" android:orientation="vertical"
                    android:padding="28dp">
                    <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/my_privacy_settings_heading" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="18dp" android:text="@string/my_private_default"
                        android:textColor="@color/cl_fg" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/my_private_default_desc"
                        android:textColor="@color/cl_muted" android:textSize="19sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="18dp" android:text="@string/my_privacy_title"
                        android:textColor="@color/cl_fg" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/my_privacy_description"
                        android:textColor="@color/cl_muted" android:textSize="19sp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="22dp" android:background="@color/cl_edge" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoRecord" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:minHeight="64dp" android:text="@string/my_auto_record"
                        android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/my_auto_record_description" android:textColor="@color/cl_muted"
                        android:textSize="18sp" />
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchResumeAfterStop" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="14dp"
                        android:minHeight="64dp" android:text="@string/my_resume_after_stop"
                        android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/my_resume_after_stop_description"
                        android:textColor="@color/cl_muted" android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
                    android:orientation="vertical" android:padding="28dp">
                    <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/my_connection_heading" />
                    <TextView android:id="@+id/myPhoneStatus" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="16dp"
                        android:text="@string/my_phone_connected" android:textColor="@color/cl_fg"
                        android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/my_phone_description"
                        android:textColor="@color/cl_muted" android:textSize="18sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPhoneLinkDetails" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="60dp"
                        android:layout_marginTop="12dp" android:text="@string/my_phone_manage" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="22dp" android:background="@color/cl_edge" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:text="@string/my_backup_title"
                        android:textColor="@color/cl_fg" android:textSize="23sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:text="@string/my_backup_description"
                        android:textColor="@color/cl_muted" android:textSize="18sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportBackup" style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_weight="1" android:text="@string/my_backup_export" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportBackup" style="@style/Carlog.Button"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:text="@string/my_backup_import" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
