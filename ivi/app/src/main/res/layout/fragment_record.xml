<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/recordScroll"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="52dp" android:paddingTop="42dp"
        android:paddingEnd="52dp" android:paddingBottom="52dp">
        <TextView style="@style/Carlog.Text.Kicker" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/record_kicker" />
        <TextView style="@style/Carlog.Text.Headline" android:text="@string/record_headline" />
        <TextView style="@style/Carlog.Text.Lead" android:text="@string/record_lead" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordLog" style="@style/Carlog.Button"
                android:layout_width="wrap_content" android:layout_height="64dp"
                android:text="@string/record_log_tab" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordStudio" style="@style/Carlog.Button.GhostSmall"
                android:layout_width="wrap_content" android:layout_height="64dp"
                android:layout_marginStart="12dp" android:text="@string/record_studio_title" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNewDrive" style="@style/Carlog.Button"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/record_new_drive" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:baselineAligned="false" android:orientation="horizontal">
            <LinearLayout android:id="@+id/recordLogPanel" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.35" android:background="@drawable/bg_panel"
                android:orientation="vertical" android:padding="32dp">
                <LinearLayout android:id="@+id/recordLatestSummary"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/Carlog.Text.PanelTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="@string/record_latest_summary_title" />
                    <TextView android:id="@+id/recordLatestDestination"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textColor="@color/cl_fg"
                        android:textSize="28sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" android:orientation="horizontal">
                        <TextView android:id="@+id/recordLatestDistance"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:background="@drawable/bg_stat"
                            android:padding="18dp" android:textColor="@color/cl_fg"
                            android:textSize="23sp" />
                        <TextView android:id="@+id/recordLatestDuration"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_marginStart="12dp" android:layout_weight="1"
                            android:background="@drawable/bg_stat" android:padding="18dp"
                            android:textColor="@color/cl_fg" android:textSize="23sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/recordLatestDate"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:textColor="@color/cl_muted"
                        android:textSize="20sp" />
                    <TextView android:id="@+id/recordLatestMediaCount"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:textColor="@color/cl_aqua"
                        android:textSize="22sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenLatestRecord" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="64dp"
                        android:layout_marginTop="14dp" android:text="@string/record_open_latest" />
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:layout_marginTop="24dp" android:layout_marginBottom="22dp"
                        android:background="@color/cl_edge" />
                </LinearLayout>
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/record_recent_title" />
                <TextView android:id="@+id/recordCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="@color/cl_muted" android:textSize="22sp" />
                <LinearLayout android:id="@+id/recordList" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="20dp"
                    android:orientation="vertical" />
            </LinearLayout>
            <LinearLayout android:id="@+id/recordStudioPanel" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:visibility="gone"
                android:background="@drawable/bg_panel" android:orientation="vertical"
                android:padding="32dp">
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="@string/record_studio_title" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:text="@string/record_studio_lead"
                    android:textColor="@color/cl_muted" android:textSize="24sp" />
                <FrameLayout android:layout_width="300dp" android:layout_height="400dp"
                    android:layout_gravity="center_horizontal" android:layout_marginTop="22dp"
                    android:background="@drawable/bg_recent_cover">
                    <ImageView android:id="@+id/studioCoverImage" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop"
                        android:visibility="gone" android:contentDescription="@string/record_studio_cover_description" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_gravity="bottom" android:orientation="vertical"
                        android:padding="24dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="CARLOG · DRIVE STORY" android:textColor="@color/cl_pill_fg"
                            android:textSize="16sp" android:textStyle="bold" />
                        <TextView android:id="@+id/studioSlideTitle" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="12dp"
                            android:text="@string/record_studio_empty" android:textColor="@color/cl_fg"
                            android:textSize="30sp" android:textStyle="bold" />
                        <TextView android:id="@+id/studioSlideLabel" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:layout_marginTop="14dp"
                            android:text="@string/record_studio_scene_label" android:textColor="@color/cl_pill_fg"
                            android:textSize="18sp" />
                    </LinearLayout>
                </FrameLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:background="@drawable/bg_stat"
                    android:orientation="vertical" android:padding="24dp">
                    <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:text="@string/record_studio_journal_title" />
                    <TextView android:id="@+id/studioJournal" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.25" android:text="@string/record_studio_empty"
                        android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenStudioLog" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="wrap_content" android:layout_height="64dp"
                        android:layout_marginTop="16dp" android:text="@string/record_studio_open_log" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:background="@drawable/bg_stat"
                    android:padding="24dp" android:text="@string/record_studio_hint"
                    android:textColor="@color/cl_fg" android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
