<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/resultScroll" android:layout_width="match_parent"
    android:layout_height="match_parent" android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="48dp" android:paddingTop="34dp"
        android:paddingEnd="48dp" android:paddingBottom="48dp">
        <TextView style="@style/Carlog.Text.Kicker" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="@string/story_detail_kicker" />
        <TextView android:id="@+id/resultHeadline" style="@style/Carlog.Text.Headline"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/my_log_detail_title" />
        <TextView android:id="@+id/resultDestination" style="@style/Carlog.Text.Lead"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/resultRecordedAt" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:textColor="@color/cl_muted" android:textSize="19sp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:baselineAligned="false"
            android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.05" android:background="@drawable/bg_panel"
                android:orientation="vertical" android:padding="24dp">
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/story_preview_heading" />
                <FrameLayout android:id="@+id/resultPreviewFrame" android:layout_width="match_parent"
                    android:layout_height="390dp" android:layout_marginTop="14dp"
                    android:background="@drawable/bg_recent_cover">
                    <ImageView android:id="@+id/resultPreviewImage" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <VideoView android:id="@+id/resultPreviewVideo" android:layout_width="match_parent"
                        android:layout_height="match_parent" android:visibility="gone" />
                    <TextView android:id="@+id/resultPreviewPlaceholder"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:gravity="center" android:padding="24dp"
                        android:text="@string/story_preview_empty" android:textColor="@color/cl_fg"
                        android:textSize="25sp" />
                </FrameLayout>
                <TextView android:id="@+id/resultPreviewStatus" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:textColor="@color/cl_aqua" android:textSize="18sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviewShorts" style="@style/Carlog.Button"
                    android:layout_width="match_parent" android:layout_height="72dp"
                    android:layout_marginTop="12dp" android:text="@string/story_preview_play" />
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="22dp"
                    android:text="@string/story_caption_heading" />
                <TextView android:id="@+id/resultLogCaption" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="10dp"
                    android:background="@drawable/bg_note" android:padding="18dp"
                    android:textColor="@color/cl_fg" android:textSize="20sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditLog" style="@style/Carlog.Button.GhostSmall"
                    android:layout_width="wrap_content" android:layout_height="64dp"
                    android:layout_marginTop="12dp" android:text="@string/story_caption_edit" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_marginStart="20dp" android:layout_weight="1"
                android:background="@drawable/bg_panel" android:orientation="vertical"
                android:padding="24dp">
                <TextView style="@style/Carlog.Text.PanelTitle" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/story_clips_heading" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStoryEdit" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="0dp" android:layout_height="64dp"
                        android:layout_weight="1" android:text="@string/story_edit" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStorySave" style="@style/Carlog.Button.GhostSmall"
                        android:layout_width="0dp" android:layout_height="64dp"
                        android:layout_marginStart="10dp" android:layout_weight="1"
                        android:text="@string/story_save" />
                </LinearLayout>
                <TextView android:id="@+id/resultMediaEmpty" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:text="@string/story_clips_empty" android:textColor="@color/cl_muted"
                    android:textSize="20sp" />
                <HorizontalScrollView android:id="@+id/resultMediaScroll"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:scrollbars="none">
                    <LinearLayout android:id="@+id/resultMediaList" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>
                <LinearLayout android:id="@+id/selectedClipControls" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="18dp"
                    android:background="@drawable/bg_stat" android:orientation="vertical"
                    android:padding="16dp" android:visibility="gone">
                    <TextView android:id="@+id/resultSelectedClipInfo" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:textColor="@color/cl_fg"
                        android:textSize="21sp" android:textStyle="bold" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClipEarlier" style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_weight="1" android:text="@string/story_clip_earlier" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClipTrim" style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_marginStart="8dp" android:layout_weight="1"
                            android:text="@string/story_clip_trim" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClipLater" style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_marginStart="8dp" android:layout_weight="1"
                            android:text="@string/story_clip_later" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClipDelete" style="@style/Carlog.Button.GhostSmall"
                            android:layout_width="0dp" android:layout_height="64dp"
                            android:layout_marginStart="8dp" android:layout_weight="1"
                            android:text="@string/story_clip_delete" />
                    </LinearLayout>
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddLogMedia" style="@style/Carlog.Button"
                    android:layout_width="match_parent" android:layout_height="72dp"
                    android:layout_marginTop="18dp" android:text="@string/story_add_media" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:text="@string/story_source_note"
                    android:textColor="@color/cl_muted" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/bg_panel"
            android:orientation="vertical" android:padding="24dp">
            <TextView android:id="@+id/resultSavedLabel" style="@style/Carlog.Text.PanelTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/my_log_saved_label" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:orientation="horizontal">
                <com.example.carlog_hd_frontend.ui.map.RouteMapView
                    android:id="@+id/resultRouteMap" android:layout_width="0dp"
                    android:layout_height="230dp" android:layout_weight="1.2"
                    android:contentDescription="@string/my_log_map_description" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="18dp" android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/resultDistance" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:background="@drawable/bg_stat"
                        android:padding="14dp" android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <TextView android:id="@+id/resultDuration" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stat" android:padding="14dp"
                        android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <TextView android:id="@+id/resultAverage" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:background="@drawable/bg_stat" android:padding="14dp"
                        android:textColor="@color/cl_fg" android:textSize="22sp" />
                    <TextView android:id="@+id/resultEvents" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:textColor="@color/cl_muted" android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnResultHome" style="@style/Carlog.Button.GhostSmall"
            android:layout_width="match_parent" android:layout_height="72dp"
            android:layout_marginTop="20dp" android:text="@string/my_log_back_to_my" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
