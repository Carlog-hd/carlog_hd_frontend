<?xml version="1.0" encoding="utf-8"?>
<!-- 일반 너비에서는 데모와 같은 4열 통계. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Carlog.StatsRow">
    <com.carlog.mobile.ui.common.StatView
        android:id="@+id/stat_preview_distance"
        style="@style/Widget.Carlog.Stat"
        app:statLabel="@string/preview_stat_distance"
        app:statValue="@string/preview_distance" />
    <com.carlog.mobile.ui.common.StatView
        android:id="@+id/stat_preview_time"
        style="@style/Widget.Carlog.Stat"
        app:statLabel="@string/preview_stat_time"
        app:statValue="@string/preview_time" />
    <com.carlog.mobile.ui.common.StatView
        android:id="@+id/stat_preview_avg_speed"
        style="@style/Widget.Carlog.Stat"
        app:statLabel="@string/preview_stat_avg_speed"
        app:statValue="@string/preview_avg_speed" />
    <com.carlog.mobile.ui.common.StatView
        android:id="@+id/stat_preview_score"
        style="@style/Widget.Carlog.Stat"
        app:statLabel="@string/preview_stat_score"
        app:statValue="@string/preview_score" />
</LinearLayout>
