<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Carlog.ButtonBar"
    android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_friend_save_action"
        style="@style/Widget.Carlog.Button.Sub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_bookmark"
        android:layout_weight="1"
        android:layout_marginEnd="@dimen/cl_space_8"
        android:text="@string/friend_save_action" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_friend_send"
        style="@style/Widget.Carlog.Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:icon="@drawable/ic_car"
        android:layout_weight="2"
        android:text="@string/friend_send" />
</LinearLayout>
