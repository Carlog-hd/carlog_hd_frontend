<?xml version="1.0" encoding="utf-8"?>
<!--
  M01 홈·알림
  - 차량 기록 도착 카드: 차량에서 동기화된 로그가 도착했을 때
  - 차량 연결 카드: 도착한 로그가 없을 때 (지금은 숨김. 상태에 따라 둘 중 하나만 표시 예정)
  - 친구들의 드라이브: 공개 범위가 허용된 피드
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/cl_space_20">

        <!-- 상단: 로고 + 알림 (.phead) -->
        <LinearLayout style="@style/Widget.Carlog.PageHeader">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    style="@style/Carlog.Text.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_logo_car" />

                <TextView
                    style="@style/Carlog.Text.Logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_logo_log"
                    android:textColor="@color/cl_accent" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_notifications"
                style="@style/Widget.Carlog.IconButton"
                android:contentDescription="@string/cd_notifications"
                android:src="@drawable/ic_bell" />
        </LinearLayout>

        <!-- 차량 기록 도착 카드 (.arrived) -->
        <LinearLayout
            android:id="@+id/section_arrived"
            style="@style/Widget.Carlog.Section">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/cl_hero_card_radius"
                app:cardElevation="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_arrived">

                    <!-- 오른쪽 위 주황 빛 -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-30dp"
                        android:layout_marginEnd="-30dp"
                        android:alpha="0.35"
                        android:background="@drawable/bg_arrived_glow" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cl_space_16">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            tools:ignore="UseCompoundDrawables">

                            <ImageView
                                android:layout_width="@dimen/cl_icon_size_tiny"
                                android:layout_height="@dimen/cl_icon_size_tiny"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_car"
                                app:tint="@color/cl_accent2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/cl_space_6"
                                android:text="@string/home_arrived_kicker"
                                android:textColor="@color/cl_accent2"
                                android:textSize="@dimen/cl_text_badge"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_arrived_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cl_space_6"
                            android:text="동해 해안도로 드라이브"
                            android:textColor="@color/cl_white"
                            android:textSize="@dimen/cl_text_card_title"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_arrived_summary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cl_space_4"
                            android:text="132.4km · 1시간 52분 · 안전점수 92 · 칭호 3개 획득"
                            android:textColor="@color/cl_on_dark_muted"
                            android:textSize="@dimen/cl_text_action" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_arrived_cta"
                            style="@style/Widget.Carlog.Button.Accent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cl_space_12"
                            android:minHeight="@dimen/cl_button_medium_height"
                            android:text="@string/home_arrived_cta"
                            android:textSize="@dimen/cl_text_body"
                            app:icon="@drawable/ic_chevron_right"
                            app:iconGravity="textEnd"
                            app:iconSize="@dimen/cl_icon_size_medium" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 차량 연결 카드: 도착한 로그가 없을 때 표시 -->
        <LinearLayout
            android:id="@+id/section_connected"
            style="@style/Widget.Carlog.Section"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    style="@style/Widget.Carlog.CardContent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/cl_icon_round_size"
                        android:layout_height="@dimen/cl_icon_round_size"
                        android:background="@drawable/bg_icon_round"
                        android:backgroundTint="@color/cl_chip_accent_bg"
                        android:importantForAccessibility="no"
                        android:padding="@dimen/cl_space_8"
                        android:src="@drawable/ic_car"
                        app:tint="@color/cl_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cl_space_12"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Carlog.Text.Body.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_connected_title" />

                        <TextView
                            style="@style/Carlog.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cl_space_4"
                            android:text="@string/home_connected_desc" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- 친구들의 드라이브 (피드) -->
        <LinearLayout style="@style/Widget.Carlog.Section">

            <LinearLayout style="@style/Widget.Carlog.SectionHeader">

                <TextView
                    style="@style/Carlog.Text.SectionTitle.Fill"
                    android:text="@string/home_feed_title" />

                <TextView
                    style="@style/Carlog.Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_feed_sub" />
            </LinearLayout>

            <!-- 지금은 같은 데모 카드를 반복 표시. 데이터 연동 시 RecyclerView + item_feed_card로 교체 -->
            <include
                android:id="@+id/feed_card_1"
                layout="@layout/item_feed_card" />

            <include
                android:id="@+id/feed_card_2"
                layout="@layout/item_feed_card" />

            <include
                android:id="@+id/feed_card_3"
                layout="@layout/item_feed_card" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
