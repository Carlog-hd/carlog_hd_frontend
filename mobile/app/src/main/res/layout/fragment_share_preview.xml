<?xml version="1.0" encoding="utf-8"?>
<!-- M05 바텀시트의 정적 목업. 회색 배경은 오버레이를 표현하며 화면 이동/닫기 동작은 미연결. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.share.SharePreviewFragment"
    tools:theme="@style/Theme.CarlogMobile">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/cl_preview_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- HTML의 max-height: 86%. 작은 화면에서는 시트 내용만 스크롤된다. -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_sheet_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.14" />

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/guideline_sheet_top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="none">

            <LinearLayout style="@style/Widget.Carlog.PreviewSheetContent">
                <include layout="@layout/view_share_sheet_handle" />
                <TextView
                    android:id="@+id/tv_preview_title"
                    style="@style/Carlog.Text.PreviewSheetTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_title" />
                <TextView
                    android:id="@+id/tv_preview_scope"
                    style="@style/Carlog.Text.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cl_space_4"
                    android:text="@string/preview_scope" />

                <include
                    layout="@layout/item_share_preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cl_space_12"
                    android:layout_marginBottom="@dimen/cl_space_14" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_share_as_is"
                    style="@style/Widget.Carlog.Button.Accent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/preview_share_as_is" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
