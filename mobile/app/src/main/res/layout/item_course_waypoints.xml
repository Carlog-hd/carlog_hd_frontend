<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/cl_space_10"
        android:paddingBottom="@dimen/cl_space_10">
        <TextView
            style="@style/Widget.Carlog.WaypointMarker"
            android:layout_width="@dimen/cl_course_waypoint_size"
            android:layout_height="@dimen/cl_course_waypoint_size"
            android:backgroundTint="@color/cl_ink"
            android:text="@string/course_marker_0" />

        <TextView
            style="@style/Carlog.Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cl_space_10"
            android:text="@string/course_waypoint_0" />
    </LinearLayout>

    <View
        style="@style/Widget.Carlog.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/cl_space_10"
        android:paddingBottom="@dimen/cl_space_10">
        <TextView
            style="@style/Widget.Carlog.WaypointMarker"
            android:layout_width="@dimen/cl_course_waypoint_size"
            android:layout_height="@dimen/cl_course_waypoint_size"
            android:backgroundTint="@color/cl_blue"
            android:text="@string/course_marker_1" />

        <TextView
            style="@style/Carlog.Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cl_space_10"
            android:text="@string/course_waypoint_1" />
    </LinearLayout>

    <View
        style="@style/Widget.Carlog.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/cl_space_10"
        android:paddingBottom="@dimen/cl_space_10">
        <TextView
            style="@style/Widget.Carlog.WaypointMarker"
            android:layout_width="@dimen/cl_course_waypoint_size"
            android:layout_height="@dimen/cl_course_waypoint_size"
            android:backgroundTint="@color/cl_blue"
            android:text="@string/course_marker_2" />

        <TextView
            style="@style/Carlog.Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cl_space_10"
            android:text="@string/course_waypoint_2" />
    </LinearLayout>

    <View
        style="@style/Widget.Carlog.Divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="@dimen/cl_space_10"
        android:paddingBottom="@dimen/cl_space_10">
        <TextView
            style="@style/Widget.Carlog.WaypointMarker"
            android:layout_width="@dimen/cl_course_waypoint_size"
            android:layout_height="@dimen/cl_course_waypoint_size"
            android:backgroundTint="@color/cl_accent"
            android:text="@string/course_marker_3" />

        <TextView
            style="@style/Carlog.Text.Body.Bold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/cl_space_10"
            android:text="@string/course_waypoint_3" />

        <TextView
            style="@style/Carlog.Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cl_space_8"
            android:text="@string/course_destination" />
    </LinearLayout>
</LinearLayout>
